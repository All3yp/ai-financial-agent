# ============================================
# REQUIRED - Core Configuration
# ============================================

# NextAuth.js - Session encryption (auto-generated)
AUTH_SECRET=

# Database - Local PostgreSQL
# Format: postgres://user:password@host:port/database
POSTGRES_URL=

# OpenAI-compatible Provider (ex: OpenRouter)
# Get key at: https://openrouter.ai/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_PROVIDER_NAME=openrouter

# ============================================
# OPTIONAL - External Services
# ============================================

# LangSmith Tracing - Observability for LLM chains
# Get key at: https://smith.langchain.com/
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-financial-agent
LANGCHAIN_TRACING_V2=true

# Vercel Blob Storage - JPEG/PNG uploads (public blobs)
# Required for uploads locally too; PDF upload is not supported
BLOB_READ_WRITE_TOKEN=

# Financial Datasets API - Powers financial analysis tools
# Coverage, quotas and price depend on the provider plan
FINANCIAL_DATASETS_API_KEY=

# Optional alternatives; Financial Datasets wins by default when its key exists
# FINANCIAL_DATA_PROVIDER=fmp
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=

# Registered FRED key of the intended user
FRED_API_KEY=

# SEC needs an application name and REAL contact email
# Setup fills this from existing identity, SEC_CONTACT_EMAIL or a prompt
SEC_USER_AGENT=
# SEC_CONTACT_EMAIL=your-real-contact@your-domain.com

# ============================================
# OPTIONAL - Autonomous Agents (Inngest)
# ============================================

# Inngest - Background job platform for autonomous agents
# Get keys at: https://app.inngest.com/
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Inngest Dev Server (for local development)
# Run: npx inngest-cli dev
# INNGEST_DEV=1