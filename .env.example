# ============================================
# REQUIRED - Core Configuration
# ============================================

# NextAuth.js - Session encryption (auto-generated)
AUTH_SECRET=

# Database - Local PostgreSQL
# Format: postgres://user:password@host:port/database
POSTGRES_URL=

# OpenAI-compatible Provider (ex: OpenRouter)
# Get key at: https://openrouter.ai/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_PROVIDER_NAME=openrouter

# ============================================
# OPTIONAL - External Services
# ============================================

# LangSmith Tracing - Observability for LLM chains
# Get key at: https://smith.langchain.com/
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-financial-agent
LANGCHAIN_TRACING_V2=true

# Vercel Blob Storage - File uploads (PDFs, images)
# Auto-created on Vercel deploy, not needed locally
BLOB_READ_WRITE_TOKEN=

# Financial Datasets API - Powers financial analysis tools
# Get free key at: https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=

# ============================================
# OPTIONAL - Autonomous Agents (Inngest)
# ============================================

# Inngest - Background job platform for autonomous agents
# Get keys at: https://app.inngest.com/
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Inngest Dev Server (for local development)
# Run: npx inngest-cli dev
# INNGEST_DEV=1